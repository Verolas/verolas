# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored. Never commit secrets.
# Never paste tokens or private keys into a chat with anyone, including AI assistants.

# Hetzner Cloud API token, scope: Read & Write on the verolas-dev project.
hcloud_token = "REPLACE_WITH_HETZNER_CLOUD_TOKEN"

# Hetzner Object Storage credentials (from the dashboard, Object Storage, Manage Credentials).
# Used by the S3 backend that stores Terraform state.
hetzner_s3_access_key = "REPLACE_WITH_HETZNER_S3_ACCESS_KEY"
hetzner_s3_secret_key = "REPLACE_WITH_HETZNER_S3_SECRET_KEY"

# Cloudflare API token, scope: Zone.DNS:Edit and Zone.Zone:Read on verolas.com only.
cloudflare_api_token  = "REPLACE_WITH_CLOUDFLARE_TOKEN"
cloudflare_account_id = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"

# SSH keypair, ed25519. The actual key content is read at apply time from these paths,
# so private key material never lands in this file.
# Generate with:
#   ssh-keygen -t ed25519 -C verolas-dev -f ~/.ssh/verolas_dev -N ""
ssh_public_key_path  = "~/.ssh/verolas_dev.pub"
ssh_private_key_path = "~/.ssh/verolas_dev"

# IP allowlists. Find your current public IP with: curl ifconfig.me
# Empty list means locked down (no access). Leave empty for an air gapped initial provision.
kube_apiserver_allow_ips = [
  # "203.0.113.42/32",
]

ssh_allow_ips = [
  # "203.0.113.42/32",
]
