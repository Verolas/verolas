# Template. Apply with real values via kubectl create secret, do not commit
# the real values. The Cluster resource references this secret by name.
#
# Generate the credentials in the Hetzner Object Storage panel of the matching
# environment, scoped to the postgres backup bucket only.
#
# Apply with:
#   kubectl -n postgres create secret generic postgres-backup-credentials \
#     --from-literal=ACCESS_KEY_ID="<access-key-id>" \
#     --from-literal=ACCESS_SECRET_KEY="<secret-key>"
apiVersion: v1
kind: Secret
metadata:
  name: postgres-backup-credentials
  namespace: postgres
type: Opaque
stringData:
  ACCESS_KEY_ID: REPLACE_WITH_HETZNER_S3_ACCESS_KEY
  ACCESS_SECRET_KEY: REPLACE_WITH_HETZNER_S3_SECRET_KEY
