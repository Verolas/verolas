{
  "name": "@verolas/web",
  "version": "0.0.0",
  "private": true,
  "description": "Verolas web app. Next.js 15, React 19, TypeScript, Tailwind 4, shadcn.",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "echo 'unit tests use Storybook test runner; see test:e2e for Playwright'",
    "test:e2e": "playwright test",
